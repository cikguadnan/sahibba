rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function superuser() { return signedIn() && request.auth.token.email == "mradnanmahmud@gmail.com"; }
    function approvedDomain() { return signedIn() && (request.auth.token.email.matches('.*@moe\\.edu\\.sg$') || request.auth.token.email.matches('.*@schools\\.gov\\.sg$')); }
    function owner(teacherId) { return signedIn() && request.auth.uid == teacherId; }
    match /teachers/{teacherId} {
      allow create: if owner(teacherId) && (approvedDomain() || superuser());
      allow read, update, delete: if owner(teacherId) || superuser();
      match /{document=**} { allow read, write: if owner(teacherId) || superuser(); }
    }
    match /publicSessions/{sessionCode} {
      allow read: if true;
      allow create: if (approvedDomain() || superuser()) && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if superuser() || (signedIn() && resource.data.teacherId == request.auth.uid);
      match /players/{playerId} { allow read, create, update: if true; allow delete: if superuser() || (signedIn() && get(/databases/$(database)/documents/publicSessions/$(sessionCode)).data.teacherId == request.auth.uid); }
      match /matches/{matchId} { allow read, update: if true; allow create, delete: if superuser() || (signedIn() && get(/databases/$(database)/documents/publicSessions/$(sessionCode)).data.teacherId == request.auth.uid); }
      match /challenges/{challengeId} { allow read, create: if true; allow update, delete: if superuser() || (signedIn() && get(/databases/$(database)/documents/publicSessions/$(sessionCode)).data.teacherId == request.auth.uid); }
    }
    match /globalDictionary/{word} {
      allow read: if true;
      allow create, update: if approvedDomain() || superuser();
      allow delete: if superuser();
    }
    match /system/{document} { allow read, write: if superuser(); }
  }
}
